		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tekst%3aTKST_Broodtekst rode initiaal">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
